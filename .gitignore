# AI assistant settings — local tool configs/session state, not project code.
# .claude/skills/ is committed (WEBAPP_PROJECT_STANDARD.md §9): those are the
# thin /deploy and /rollback wrappers, not local session state.
.claude/*
!.claude/skills/
.cline/
.clinerules

# Private
.env

# Per-environment /deploy config (WEBAPP_PROJECT_STANDARD.md §9) — see deploy.config.example
deploy.config

# Generated output
archive/
web/data/
web/images/
web/labels/
web/logo/

# Rollback snapshots (WEBAPP_PROJECT_STANDARD.md §14B) — this is a public
# repo and snapshots contain the full rendered site, not just its inputs.
deploy/releases/

# Input (user's own files)
input/brauhelfer.sqlite
input/enrichment/
input/images/
input/influxdb/
input/logo/

# Python
__pycache__/
*.pyc

# Screenshots (user adds their own images)
docs/screenshots/*.jpg
docs/screenshots/*.png
docs/screenshots/*.webp